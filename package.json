{
  "name": "ali-ui",
  "description": "Create Alibaba Cloud clusters in Rancher",
  "version": "1.1.0",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@rancher/shell": "3.0.15-rc.4",
    "@types/lodash": "4.17.25",
    "ipaddr.js": "2.4.0",
    "semver": "7.8.5",
    "vuex": "4.1.0"
  },
  "resolutions": {
    "@tootallnate/once": "2.0.1",
    "basic-ftp": "6.2.2",
    "cookie": "0.7.2",
    "cross-spawn": "7.0.6",
    "**/diff2html/diff": "5.2.2",
    "fast-xml-parser": "5.11.1",
    "form-data": "4.0.6",
    "markdown-it": "14.3.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.6",
    "qs": "6.16.0",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6",
    "zod": "4.6.6"
  },
  "@rancher/shell": {
    "eslintLegacyPackages": {
      "eslint-plugin-jest": "^24"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "lint": "./node_modules/@rancher/shell/scripts/lint --max-warnings 0 --ext .js,.ts,.vue .",
    "clean": "./node_modules/@rancher/shell/scripts/clean",
    "build-pkg": "./node_modules/@rancher/shell/scripts/build-pkg.sh",
    "serve-pkgs": "./node_modules/@rancher/shell/scripts/serve-pkgs",
    "publish-pkgs": "./node_modules/@rancher/shell/scripts/extension/publish",
    "parse-tag-name": "./node_modules/@rancher/shell/scripts/extension/parse-tag-name",
    "migrate": "node ./scrips/vue-migrate.js"
  },
  "devDependencies": {
    "@vue/cli-service": "5.0.8",
    "@vue/test-utils": "2.4.6",
    "@vue/vue3-jest": "29.2.6",
    "typescript": "5.6.3",
    "vue": "3.5.42",
    "yaml-lint": "1.7.0",
    "yarn": "1.22.22"
  }
}
